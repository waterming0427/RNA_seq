#!/bin/bash
#SBATCH -A pccr
#SBATCH -t 04:00:00
#SBATCH -N 1
#SBATCH -n 8
#SBATCH --mem=32G
#SBATCH --job-name=featurecounts
#SBATCH --mail-type=FAIL,BEGIN,END
#SBATCH --output=featurecounts-%j.out
#SBATCH --error=featurecounts-%j.err

# Load Subread
module --force purge
ml biocontainers subread/2.0.1

# Define paths
GTF=/depot/edykhui/data/ming/IU_RNAseq_2025/genome_files/gencode.v45.annotation.gtf
OUTDIR=/depot/edykhui/data/ming/IU_RNAseq_2025/featurecounts
mkdir -p $OUTDIR

# Get all BAM files
BAMS=$(ls /depot/edykhui/data/ming/IU_RNAseq_2025/star_align_array/*/*.bam)

# Run featureCounts
featureCounts -T 8 -p -s 2 \
  -a $GTF -o $OUTDIR/gene_counts.txt $BAMS


